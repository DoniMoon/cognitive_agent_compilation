{
  "dataset_path": "text_questions.jsonl",
  "logs_dir": "experiments/logs",
  "global_seed": 1234,
  "max_epochs": 10,
  "threshold": 0.5,
  "target_pass_rate": 0.5,
  "max_teacher_iterations_per_problem": 10,
  "max_steps_per_problem_per_agent": 30,
  "inference_backend": "transformers",
  "device": "cuda:0",
  "slm_model": "Qwen/Qwen3.5-2B",
  "kb": {
    "dir": "kb",
    "embedding_model": "google/embeddinggemma-300m",
    "beta": 5.0,
    "retrieval_threshold": 0.3,
    "enable_near_duplicate": false,
    "allow_hash_fallback": false,
    "isolate_per_run": true
  },
  "teacher": {
    "endpoint": "http://127.0.0.1:8080/v1/chat/completions",
    "model": "teacher",
    "temperature": 0.0,
    "max_new_dm_per_teacher_call": 30,
    "allow_heuristic_fallback": false,
    "max_mcp_query_topk_calls": 8,
    "max_mcp_score_calls": 60,
    "request_timeout_s": 300,
    "max_tokens": 8192,
    "bootstrap_max_new_dm_per_teacher_call": 8,
    "request_retries": 8,
    "retry_backoff_s": 3.0,
    "max_teacher_input_chars": 30000,
    "max_teacher_input_chars_retry": 8000,
    "max_steps_per_ca_run_for_teacher": 6,
    "enable_tool_planner": false
  },
  "require_pass_before_next_problem": true,
  "hard_max_attempts_per_problem": 0,
  "runtime": {
    "torch_dtype": "float16",
    "low_cpu_mem_usage": true,
    "use_chat_template": true,
    "fail_on_nonfinite": true,
    "fail_on_noop": true,
    "noop_retry_attempts": 5,
    "force_recall_each_step": true,
    "log_prompts": false,
    "debug_prompt_char_limit": 20000,
    "model_torch_dtype_overrides": {}
  }
}
